# Copy to .env for local development. Never commit the real .env file.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Neon / Railway / Render connection string. Leave blank to use local SQLite.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_CONN_MAX_AGE=600
DB_REQUIRE_SSL=true

# --- Cache ------------------------------------------------------------------
# Leave blank to use in-process memory cache (development).
REDIS_URL=redis://localhost:6379/0

# --- Email ------------------------------------------------------------------
# Locally the console backend prints messages to the terminal, so no setup is
# needed to test the confirmation flow.
#
# For real delivery, this project uses Brevo's REST API via
# marketplace.email_backend.BrevoEmailBackend (no extra dependency — `requests`
# is already required).
#   1. Sign up at https://www.brevo.com (free, 300 emails/day, no card)
#   2. Brevo → SMTP & API → API Keys → Generate a new API key
#   3. Paste it below and check delivery:
#      python manage.py send_test_email --to you@example.com
#
# NOTE: Brevo issues API keys and SMTP keys SEPARATELY. An API key is NOT an
# SMTP password — using one over SMTP fails with "535 5.7.8 Authentication
# failed". If you would rather use plain SMTP, set
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill in EMAIL_HOST / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD instead.
DJANGO_EMAIL_BACKEND=marketplace.email_backend.BrevoEmailBackend
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com
DEFAULT_FROM_EMAIL=AgriMarket <no-reply@example.com>

# Only for the plain SMTP backend (ignored by the Brevo backend).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Public base URL, used to build absolute links in emails.
# Must be reachable from wherever the link is opened. If you read mail on your
# phone, 127.0.0.1 points at your phone, not your laptop - use the LAN address
# the dev server is actually reachable on, e.g. http://192.168.1.5:8000
SITE_URL=https://your-app.onrender.com

# --- Email verification -----------------------------------------------------
# New accounts must confirm their address before signing in (web and API).
# Set to false to skip confirmation entirely (useful for demos).
EMAIL_VERIFICATION_REQUIRED=true
# How long a confirmation link stays valid.
EMAIL_VERIFICATION_MAX_AGE_HOURS=48
# Minimum seconds between re-sends of the same link.
EMAIL_VERIFICATION_RESEND_COOLDOWN=60

# How long a "forgot password" link stays valid.
PASSWORD_RESET_TIMEOUT_HOURS=24

# --- Notifications ----------------------------------------------------------
# Order / offer / payment / delivery / payout email. Set to false to silence
# every automated message without touching any call site — useful while a mail
# provider is misbehaving. Verification mail is unaffected.
NOTIFICATIONS_ENABLED=true

# --- AI (OpenAI-compatible; SambaNova Cloud by default) ----------------------
AI_API_KEY=
AI_BASE_URL=https://api.sambanova.ai/v1
AI_MODEL=Meta-Llama-3.1-8B-Instruct
AI_TIMEOUT_SECONDS=20
THROTTLE_AI=30/hour

# --- Payments (Razorpay: UPI, cards, netbanking) ----------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# --- Direct UPI (no gateway, no keys: pay straight to a UPI ID) -------------
# Set your VPA (e.g. yourname@okaxis) to show "Pay via UPI" on orders.
# Leave blank to hide the option.
UPI_ID=
UPI_PAYEE_NAME=AgriMarket

# --- Marketplace economics --------------------------------------------------
PLATFORM_FEE_PERCENT=2.0
DELIVERY_BASE_FEE=25.0
DELIVERY_PER_KM_FEE=6.0
# Days a settled order (or completed shipment) waits before it can be paid out,
# leaving room for a return, quality claim or refund to be taken back first.
PAYOUT_HOLD_DAYS=7
SITE_NAME=AgriMarket

# --- Security (production) --------------------------------------------------
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000

# --- Optional S3 media storage ---------------------------------------------
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
